# Venezuela Rates API — Environment Variables
# Copy this file to .env and fill in the values

# Required: API key for authentication (X-API-Key header)
API_KEY=your-secret-api-key-here

# Optional: Server port (default: 8080)
PORT=8080

# Optional: SQLite database path (default: ./rates.db)
DB_PATH=./rates.db

# Optional: Hour to run daily scraping in Caracas timezone, 0-23 (default: 8)
SCRAPE_HOUR=8

# Optional: Max requests per minute per IP (default: 60)
RATE_LIMIT=60
